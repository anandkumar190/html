Options -MultiViews
RewriteEngine On

# 1) If the requested path is an existing file or directory, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2) Route pretty URL to matching .php file (e.g. /home -> home.php, /dashboard-map -> dashboard-map.php)
RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# 3) Fallback for virtual routes
RewriteRule ^ index.php [L]
